# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB (default). Replace with your Atlas URI for production.
MONGODB_URI=mongodb://127.0.0.1:27017/flames_db

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://flames-application.vercel.app

# ---- Date / Time ----
# IANA timezone used to build human-friendly date/day fields. Default: Asia/Kolkata (Indian Standard Time)
TIMEZONE=Asia/Kolkata

# ---- Security & Visitor Observability Layer ----
# Master Killswitch (true = enabled, false = completely disabled)
VISITOR_TRACKING_ENABLED=true

# IP Logging & Retention
IP_LOGGING_ENABLED=true
IP_RETENTION_DAYS=30
IP_GEOLOCATION_ENABLED=false

# Privacy control: Log submitted names in telemetry (default false)
FLAMES_INPUT_LOGGING_ENABLED=false

# Active visitor threshold window in seconds (default: 300 = 5 minutes)
ACTIVE_VISITOR_WINDOW_SECONDS=300

# Administrator Credentials & Signed Sessions
ADMIN_PASSWORD=admin1234567890
ADMIN_SESSION_SECRET=flames-super-secret-admin-session-salt-2026

# Cookie Security (true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_GENERAL_MAX=150
RATE_LIMIT_FLAMES_MAX=30
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WINDOW_MS=900000