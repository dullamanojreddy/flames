# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB (default). Replace with your Atlas URI for production.
MONGODB_URI=mongodb://127.0.0.1:27017/flames_db

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5500

# ---- Date/time ----
# IANA timezone used to build the human-friendly date/day fields.
# Defaults to UTC. Example: Asia/Kolkata
TIMEZONE=UTC

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100